{
  "schema": "esdm.e2.empirical_replication_contract.v1",
  "status": "DRAFT_NOT_AUTHORIZED",
  "drafted_date": "2026-09-27",
  "purpose": "Prospective independent empirical replication of the frozen v0.4-R5b activity/state decomposition after the first Snapshot Japan endpoint terminated on a temporal-integrity rule.",
  "relationship_to_active_programme": {
    "active_model_generation": "v0.4-R5b",
    "active_empirical_endpoint": "EMPIRICAL_ENDPOINT_CONSUMED_STOP",
    "authoritative_status": "docs/empirical/PROGRAMME_TERMINAL_STATUS.json",
    "rescue_of_first_endpoint": false,
    "modifies_first_endpoint": false,
    "modifies_r5b_model": false,
    "new_semisynthetic_generation": false,
    "separate_named_programme": true
  },
  "prior_evidence_used_only_to_define_e2_rules": {
    "snapshot_japan": {
      "unique_animal_events": 7620,
      "outside_deployment_events": 13,
      "violation_rate": 0.001706,
      "direction": "after_deployment_end_only",
      "all_within_seconds": 86400
    },
    "awd_pilot2": {
      "unique_animal_events": 86,
      "outside_deployment_events": 0,
      "violation_rate": 0
    },
    "interpretation": "The E2 temporal adjudication rule is prospectively frozen from prior audits and is not a reinterpretation of the first empirical endpoint."
  },
  "candidate_selection": {
    "selected_candidate": null,
    "candidate_selection_status": "OPEN_RESPONSE_BLIND",
    "prior_response_opened_datasets_ineligible": [
      "Snapshot Japan 2023 Camtrap DP 1.0.1",
      "Amsterdamse Waterleidingduinen pilot2"
    ],
    "required_independence": "different camera-trap study/package from every dataset whose observation rows have already been opened by the esdm empirical programme",
    "allowed_before_candidate_freeze": [
      "publication and repository metadata",
      "datapackage.json metadata",
      "deployments.csv",
      "observations resource schema or header only",
      "file sizes, checksums and transport metadata"
    ],
    "forbidden_before_candidate_freeze": [
      "observations.csv data rows",
      "taxon frequencies",
      "focal-taxon event counts",
      "count/state frequencies",
      "heldout response values",
      "model scores"
    ],
    "minimum_geometry": {
      "training_deployments": 50,
      "heldout_deployments": 12,
      "strict_east_extrapolation": true
    },
    "required_camtrapdp_fields": {
      "deployments": [
        "deploymentID",
        "latitude",
        "longitude",
        "deploymentStart",
        "deploymentEnd"
      ],
      "observations": [
        "observationID",
        "deploymentID",
        "eventID",
        "eventStart",
        "observationLevel",
        "observationType",
        "scientificName",
        "count"
      ]
    },
    "focal_taxon_rule": "A candidate-specific child contract must name one focal mammal from publication/metadata grounds before any observation data row is opened. Selection from observed response abundance is forbidden.",
    "state_space": [
      "solitary",
      "group"
    ],
    "state_mapping": {
      "solitary": "event-level focal observation count == 1",
      "group": "event-level focal observation count >= 2",
      "missing_or_nonpositive_count": "unlabeled; never reassigned"
    }
  },
  "response_blind_geometry_and_streams": {
    "east_holdout_rule": {
      "candidate_cuts": "every strict gap between unique deployment longitudes leaving at least 50 training deployments west and at least 12 heldout deployments east",
      "selection": "largest longitude gap; ties choose the easternmost cut",
      "integrity": "min heldout longitude > max training longitude"
    },
    "training_role_assignment": {
      "salt": "esdm-e2-r5b-stream-v1|",
      "hash": "SHA256(salt + UTF-8 deploymentID), first byte",
      "opportunistic_presence": "0..63",
      "calibrated_presence": "64..127",
      "state_annotated": "128..207",
      "state_calibration": "208..255",
      "minimum_each_training_role": 8,
      "heldout_role": "state_annotated_only",
      "direct_state_calibration_heldout_exposure": 0
    },
    "if_geometry_or_role_minimum_fails": "REJECT_PRE_RESPONSE_GEOMETRY"
  },
  "temporal_integrity_stage": {
    "timing": "after candidate child contract is frozen and authorized, but before scientificName/count/state values are read",
    "allowed_columns": [
      "deploymentID",
      "eventID",
      "eventStart",
      "observationLevel",
      "observationType"
    ],
    "exact_validity_rule": "deploymentStart <= eventStart <= deploymentEnd",
    "prospective_quarantine_rule": {
      "applies_to": "unique event-level animal event identities across the whole candidate package, before focal-taxon filtering",
      "tolerated_direction": "after deployment end only",
      "maximum_lateness_seconds": 86400,
      "maximum_quarantined_fraction": 0.005,
      "before_deployment_start_allowed": 0,
      "missing_deployment_allowed": 0,
      "unparseable_event_time_allowed": 0,
      "action": "freeze the qualifying event identities into a quarantine set; exclude those identities from every ecological stream without extending deployment effort"
    },
    "stop_conditions": [
      "any event occurs before deployment start",
      "any after-end event exceeds 24 hours",
      "quarantined fraction exceeds 0.5%",
      "any animal event has missing deployment identity",
      "any required event timestamp is unparseable"
    ],
    "prohibited_repairs": [
      "deployment interval widening",
      "timestamp editing",
      "taxon-specific temporal exceptions",
      "post-response changes to the 24-hour boundary",
      "post-response changes to the 0.5% candidate-level fraction",
      "reintroduction of quarantined events"
    ],
    "pass_receipt_required_before_full_response": true,
    "quarantine_event_id_set_sha256_required": true
  },
  "frozen_r5b_information_architecture": {
    "streams": [
      "opportunistic PresenceOnly-like count stream with unknown effort component",
      "calibrated PresenceOnly-like count stream with explicit deployment effort",
      "state-annotated count stream consuming suitability, activity and state",
      "direct conditional state-composition calibration stream consuming state only"
    ],
    "ecological_channels": [
      "suitability",
      "activity",
      "conditional state composition"
    ],
    "domain_requires": [
      "space",
      "day-of-year",
      "hour"
    ],
    "process_covariate_roles": {
      "suitability": [
        "precipitation",
        "latitude",
        "eastness",
        "seasonal phase"
      ],
      "activity": [
        "precipitation",
        "eastness",
        "seasonal phase",
        "diurnal phase"
      ],
      "state": [
        "precipitation",
        "eastness",
        "seasonal phase",
        "diurnal phase"
      ]
    },
    "climate_source_rule": "The candidate-specific precipitation source and extraction receipt must be frozen before full response opening; response-conditioned feature search is forbidden."
  },
  "frozen_fit_and_endpoints": {
    "mcmc": {
      "warmup": 300,
      "posterior_samples": 350,
      "chains": 2,
      "target_accept_probability": 0.9
    },
    "fits": [
      "full",
      "activity knockout",
      "state knockout"
    ],
    "primary": [
      "sampling/convergence diagnostics",
      "east-heldout full log predictive density",
      "east-heldout activity-knockout log predictive density",
      "east-heldout state-knockout log predictive density",
      "east-heldout full-minus-activity-knockout gain derived from the two absolute scores",
      "east-heldout full-minus-state-knockout gain derived from the two absolute scores"
    ],
    "secondary": [
      "posterior parameter summaries",
      "activity probabilities",
      "state probabilities",
      "derived spatial/temporal summaries"
    ],
    "empirical_interpretation": {
      "activity_process_predictive_support": "activity gain > 0 with acceptable fit diagnostics",
      "state_process_predictive_support": "state gain > 0 with acceptable fit diagnostics",
      "no_parameter_recovery_claim": true,
      "no_causal_claim": true
    },
    "heldout_score_serialization": {
      "required_absolute_fields": [
        "full_heldout_log_score",
        "activity_knockout_heldout_log_score",
        "state_knockout_heldout_log_score"
      ],
      "derived_gain_fields": {
        "activity_gain": "full_heldout_log_score - activity_knockout_heldout_log_score",
        "state_gain": "full_heldout_log_score - state_knockout_heldout_log_score"
      },
      "same_heldout_observations_across_all_three_fits": true,
      "score_contract": {
        "kind": "log",
        "name": "mean_heldout_log_predictive_density",
        "orientation": "higher_is_better",
        "common_scoring_rule": true,
        "common_reference_measure": true,
        "unit": "nats_per_east_heldout_state_block_context"
      },
      "gain_only_serialization_allowed": false,
      "reconstruct_absolute_scores_from_gain_allowed": false,
      "row_level_odsp_table": {
        "required": true,
        "row_unit": "one east-heldout deployment",
        "row_id": "deploymentID",
        "group_semantics": "east-heldout camera deployment",
        "minimum_group_count": 12,
        "weight": "1.0 per deployment",
        "population_cluster": null,
        "score_definition_per_model": "mean posterior log predictive density over the same two heldout state blocks and all scored day-of-year/hour contexts within that deployment",
        "required_columns": [
          "deploymentID",
          "full_heldout_log_score",
          "activity_knockout_heldout_log_score",
          "state_knockout_heldout_log_score"
        ],
        "same_state_block_context_cells_across_all_three_fits": true,
        "zero_count_cells_retained": true,
        "post_response_row_grouping_changes_allowed": false,
        "post_response_score_aggregation_changes_allowed": false
      },
      "aggregate_consistency": {
        "equal_weight_mean_of_deployment_rows_must_equal_aggregate_score": true,
        "absolute_tolerance": 1e-12,
        "required_for": [
          "full_heldout_log_score",
          "activity_knockout_heldout_log_score",
          "state_knockout_heldout_log_score"
        ]
      }
    }
  },
  "one_open_governance": {
    "candidate_child_contract_required": true,
    "temporal_integrity_authorization_required": true,
    "full_response_authorization_required_after_temporal_pass": true,
    "response_conditioned_retuning_allowed": false,
    "replacement_candidate_after_full_response_consumption_allowed": false,
    "failure_remains_failure": true,
    "post_response_score_field_changes_allowed": false,
    "post_response_odsp_information_order_changes_allowed": false
  },
  "current_authorization": {
    "candidate_search": true,
    "candidate_selected": false,
    "temporal_integrity_opening": false,
    "full_ecological_response_opening": false,
    "model_fitting": false
  },
  "odsp_downstream_export": {
    "status": "PROSPECTIVE_SERIALIZATION_ONLY",
    "changes_e2_scientific_decision": false,
    "export_requires_completed_full_response_fit": true,
    "export_requires_finite_absolute_scores": true,
    "export_requires_same_heldout_observations": true,
    "activity_contrast": {
      "lower_information": [
        "suitability",
        "state"
      ],
      "upper_information": [
        "suitability",
        "state",
        "activity"
      ],
      "lower_score_field": "activity_knockout_heldout_log_score",
      "upper_score_field": "full_heldout_log_score"
    },
    "state_contrast": {
      "lower_information": [
        "suitability",
        "activity"
      ],
      "upper_information": [
        "suitability",
        "activity",
        "state"
      ],
      "lower_score_field": "state_knockout_heldout_log_score",
      "upper_score_field": "full_heldout_log_score"
    },
    "activity_and_state_are_parallel_not_ordered": true,
    "global_information_ladder_authorized": false,
    "downstream_population_audit_role": "descriptive_only",
    "eog_consumption_authorized": false,
    "n4_action_authorized": false,
    "group_semantics": "east-heldout camera deployment",
    "minimum_population_group_count": 12,
    "population_cluster": null,
    "population_inference_role": "descriptive population-of-heldout-deployments audit; not a literature-prevalence or causal claim and not an authorization for spatial survey ranking",
    "aggregate_only_export_allowed": false,
    "requires_row_level_score_table": true
  }
}
