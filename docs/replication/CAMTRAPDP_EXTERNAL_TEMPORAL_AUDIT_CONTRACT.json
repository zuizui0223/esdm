    "published_size_bytes_approx": 345900000,
    "required_resource_basenames": ["deployments.csv", "observations.csv"]
  },
  "frozen_rule": {
    "population": "unique deploymentID + eventID among observationLevel=event and observationType=animal with parseable eventStart",
    "inside": "deploymentStart <= eventStart <= deploymentEnd",
