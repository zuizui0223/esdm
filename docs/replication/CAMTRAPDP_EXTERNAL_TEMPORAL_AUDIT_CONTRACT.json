    "no_padding": true,
    "no_timestamp_repair": true,
    "no_row_deletion": true
  },
  "reported_metrics": [
    "deployment_count",
    "observation_row_count",
    "unique_animal_event_count",
    "interval_violation_count_and_rate",
    "before_start_and_after_end_counts",
    "absolute_offset_seconds_summary",
    "violations_within_1_hour_24_hours_7_days",
    "affected_deployment_count",
    "timezone_offset_triplets"
  ],
  "prohibited": {
    "ecological_model_fit": true,
    "heldout_scoring": true,
    "threshold_tuning": true,
    "interval_widening": true,
    "timestamp_correction": true,
    "change_to_first_empirical_result": true
  },
  "execution": {
    "authorization_marker": "docs/replication/CAMTRAPDP_EXTERNAL_TEMPORAL_AUDIT_AUTHORIZED",
    "marker_must_be_newly_added": true,
    "one_authorized_run": true,
    "workflow_dispatch_enabled": false
  }
}
