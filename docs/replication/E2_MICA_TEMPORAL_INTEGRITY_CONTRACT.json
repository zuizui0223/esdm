    "response_blind_artifact_id": 10930544605
  },
  "column_projection": {
    "allowed_application_columns": [
      "deploymentID",
      "eventID",
      "eventStart",
      "observationLevel",
      "observationType"
    ],
    "prohibited_application_columns": [
      "scientificName",
      "count",
      "classificationMethod",
      "individualID",
      "lifeStage",
      "sex",
      "behavior"
    ],
    "operational_definition_of_not_opened": "Archive and CSV row bytes may pass through transport/parser infrastructure, but prohibited ecological fields must never be projected into named application variables, retained in audit records, compared, summarized, logged, serialized or used for branching.",
    "taxon_filtering_allowed": false,
    "count_or_state_mapping_allowed": false
  },
  "event_population": {
    "filter": "observationLevel == event AND observationType == animal",
    "identity": [
      "deploymentID",
      "eventID"
    ],
    "duplicate_rule": "duplicate rows with the same event identity must have exactly one consistent eventStart; any conflicting eventStart stops the audit",
    "deployment_id_required": true,
    "event_id_required": true,
    "event_start_required": true,
    "event_start_parse_rule": "ISO-8601 parseable timestamp with explicit UTC offset",
    "denominator": "all unique event-level animal event identities in the candidate package before focal-taxon filtering"
  },
  "deployment_integrity": {
    "deployment_interval_source": "frozen deployments.csv",
    "validity_rule": "deploymentStart <= eventStart <= deploymentEnd",
    "missing_deployment_allowed": 0,
    "before_start_allowed": 0,
    "unparseable_or_offsetless_event_start_allowed": 0
  },
  "quarantine_rule": {
    "tolerated_direction": "after deployment end only",
    "maximum_lateness_seconds": 86400,
    "maximum_quarantined_fraction": 0.005,
    "denominator": "all unique event-level animal event identities",
    "event_identity_serialization": "deploymentID + U+001F + eventID",
    "quarantine_set_order": "lexicographic by serialized event identity",
    "quarantine_set_sha256_required": true,
    "later_action": "exclude frozen quarantine identities from every ecological stream without widening deployment intervals or adding effort"
  },
  "stop_conditions": [
    "any unique event identity has missing deploymentID or eventID",
    "any event-level animal eventStart is missing, unparseable or lacks UTC offset",
    "duplicate event identity has conflicting eventStart values",
    "event deploymentID is absent from frozen deployments",
    "any event occurs before deploymentStart",
    "any after-end event is more than 86400 seconds late",
    "quarantined unique-event fraction exceeds 0.005"
  ],
  "valid_terminal_statuses": [
    "TEMPORAL_INTEGRITY_PASS_CLEAN",
    "TEMPORAL_INTEGRITY_PASS_WITH_QUARANTINE",
    "STOP_TEMPORAL_INTEGRITY"
  ],
  "pass_requirements": {
    "source_fingerprints_match_response_blind_receipt": true,
    "stop_condition_count": 0,
    "quarantine_manifest_and_sha256_frozen": true,
    "full_response_authorization_still_required": true
  },
  "prohibited_repairs": [
    "deployment interval widening",
    "timestamp editing",
    "timezone imputation",
    "taxon-specific temporal exceptions",
    "post-opening change to 86400-second boundary",
    "post-opening change to 0.005 quarantine fraction",
    "reintroduction of quarantined events"
  ],
  "response_boundary": {
    "scientificName_projected": false,
    "count_projected": false,
    "state_mapping_performed": false,
    "taxon_frequency_computed": false,
    "focal_event_count_computed": false,
